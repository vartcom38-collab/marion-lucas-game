{
  "version": 1,
  "name": "MonIA Video V2",
  "enabled": true,
  "parallelToLegacy": true,
  "paidProvidersAllowed": false,
  "candidateOnly": true,
  "engine": {
    "id": "ltx-diffusers-i2v",
    "model": "Lightricks/LTX-Video",
    "mode": "image-to-video",
    "torchDtype": "float16",
    "cpuOffload": true
  },
  "defaults": {
    "width": 432,
    "height": 768,
    "frames": 49,
    "fps": 12,
    "steps": 8,
    "seed": 260922
  },
  "outputRoot": "public/resources/monia-v2/candidates",
  "identityPolicy": {
    "referenceRequired": true,
    "promptOnlyCharacters": false,
    "referenceConfig": "config/monia-reference-packs.json"
  }
}
