{
  "version": 3,
  "status": "locked",
  "principle": "generation -> candidate -> validation gate -> live",
  "gameplay": {
    "playerNeverSeesGenerationMechanics": true,
    "preferApprovedCache": true,
    "allowUnapprovedMediaInLiveGameplay": false,
    "allowStaticZoomAsFinalVideo": false,
    "unexpectedChoiceStrategy": "reuse-approved-or-safe-neutral-fallback-while-preparing-new-candidate",
    "sceneRouting": {
      "inputs": [
        "current place",
        "time of day",
        "recent player action",
        "recent messages",
        "relationship level",
        "trust",
        "chemistry",
        "official/engaged/married state",
        "children state",
        "recent memories and events"
      ],
      "routes": [
        "message-only",
        "visio",
        "lucas-solo-drama",
        "couple-drama",
        "family-drama",
        "environment-beat"
      ],
      "physicalCoPresenceRequiredForCoupleDrama": true,
      "neverInventLucasPhysicalPresence": true,
      "preferSilenceOverWrongScene": true
    }
  },
  "approval": {
    "calibrationMode": "human",
    "surpriseMode": "armed",
    "surpriseModePurpose": "preserve player discovery by avoiding scene-by-scene preview once stable production domains are trusted",
    "surpriseModeActivationRequires": [
      "lucas identity pipeline validated",
      "marion identity pipeline validated",
      "duo identity continuity validated",
      "motion/body language profiles validated",
      "scene continuity validated",
      "assembled video quality gate validated"
    ],
    "whenSurpriseModeActive": {
      "humanPreviewsEveryScene": false,
      "validationAuthority": "MonIA quality gate",
      "candidateStageStillRequired": true,
      "autoPublishWithoutValidation": false,
      "publishOnlyAfterGatePass": true,
      "manualReviewOnGateFailure": true,
      "manualReviewOnNewUntrustedDomain": true,
      "neverRevealFutureSceneContentToPlayer": true
    },
    "untrustedDomainsAlwaysRequireHumanCalibration": [
      "new character identity",
      "new Lucas identity anchor",
      "new Marion identity anchor",
      "new duo identity method",
      "new voice model or voice identity",
      "new intimate-contact grammar",
      "new family/child interaction grammar",
      "new generation backend behavior"
    ]
  },
  "video": {
    "finalMode": "true_video_required",
    "targetSceneSeconds": [12, 60],
    "shotSeconds": [1.5, 8],
    "continuity": [
      "same canonical face",
      "same age",
      "same hairstyle within scene",
      "same wardrobe within scene unless story explicitly changes it",
      "same geography and lighting continuity"
    ],
    "requiredHumanMotion": [
      "breathing",
      "blinking",
      "gaze shifts",
      "subtle head movement",
      "posture changes",
      "natural hand timing",
      "body weight shifts"
    ]
  },
  "lucas": {
    "identity": "locked official Lucas canon",
    "noTattoo": true,
    "noFacialScar": true,
    "noLookalikeDrift": true,
    "performanceReferencesAreMotionOnly": false,
    "performanceReferencesMayGuide": [
      "male body presence",
      "posture and silhouette",
      "full-body stance and walk",
      "shoulder line and weight shifts",
      "protective presence",
      "contained romantic tension",
      "gentle physical contact",
      "family protective handling",
      "camera timing"
    ],
    "identityAuthorityAlways": "locked official Lucas canon"
  },
  "marion": {
    "identity": "locked official Marion canon",
    "playerAgency": true,
    "neverDecideForPlayer": true
  },
  "sceneGrammar": {
    "allowedShots": [
      "extreme-close",
      "close",
      "medium-close",
      "medium",
      "full",
      "wide",
      "two-shot",
      "detail"
    ],
    "romance": [
      "distance",
      "eye contact",
      "breath",
      "pauses",
      "restrained touch",
      "lean-in",
      "posture",
      "silence"
    ],
    "family": [
      "protective stance",
      "natural carrying",
      "supportive hand placement",
      "stable body balance",
      "quiet eye contact"
    ],
    "forbiddenShortcuts": [
      "Ken Burns still-image motion",
      "source-video replay disguised as generation",
      "identity replacement from motion reference actor",
      "candidate published before its required validation gate"
    ]
  },
  "visio": {
    "states": [
      "listening",
      "speaking",
      "reaction",
      "thinking",
      "silence"
    ],
    "differentEachCall": true,
    "contextSensitive": [
      "mood",
      "place",
      "time of day",
      "relationship",
      "recent beat",
      "outfit",
      "background",
      "lighting"
    ],
    "missingApprovedStateBehavior": "neutral-call-ui-without-unapproved-video"
  },
  "storySafety": {
    "noFutureSpoilers": true,
    "noInventedMajorTwists": true,
    "noInfidelity": true,
    "noForcedPlayerEmotion": true,
    "microDramaMustFollowExistingContext": true
  }
}
